# Usado só pelo docker-compose.yml da raiz, pra criar os containers postgres/
# redis (os valores aqui viram ${DB_USERNAME} etc dentro do compose). Precisam
# bater com o que está em Ant_CRM_Bn/.env, Ant_Engine_Bn/.env e
# Ant_MSG_Bn/.env (cada um desses .env guarda os OUTROS segredos específicos
# do seu serviço, tipo CRM_JWT_SECRET e ENGINE_API_KEY - não duplicar aqui).

DB_USERNAME=postgres
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_PASSWORD=change_me
DB_NAME=wa_saas

# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change_me
