# Único .env usado pelo docker-compose.yml da raiz (o que você cola no campo
# "Environment" do Dokploy). Reúne o que antes ficava espalhado em
# Ant_CRM_Bn/.env, Ant_Engine_Bn/.env e Ant_MSG_Bn/.env - só pra rodar via
# Docker. Pra rodar cada projeto direto (npm run start:dev, sem Docker),
# continue usando o .env.example de cada subpasta normalmente.

# --- PostgreSQL (compartilhado por crm-api e msg-worker) ---
DB_USERNAME=postgres
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_PASSWORD=change_me
DB_NAME=wa_saas

# --- Redis (compartilhado por crm-api e msg-worker) ---
# NUNCA deixe em branco em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change_me

# --- Engine (Baileys) ---
# Toda rota do engine exige "Authorization: Bearer <esse valor>" - usado
# tambem por crm-api e msg-worker pra chamar o engine, por isso é UM valor só
# compartilhado pelos 3 serviços.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENGINE_API_KEY=

# Criptografa (AES-256-GCM) as credenciais de sessão do Baileys em disco.
# NUNCA reaproveite entre ambientes - sem essa chave as sessões existentes
# ficam irrecuperáveis. Faça backup dela separado do volume de sessões.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSIONS_ENCRYPTION_KEY=

LOG_LEVEL=info

# Meta Cloud API (número oficial, opcional)
META_API_VERSION=v21.0
# Exemplo: META_INSTANCES={"oficial-1":{"phoneNumberId":"1234567890","accessToken":"EAAxxxxx"}}
META_INSTANCES=

# --- Anti-ban (usado por crm-api pra exibir e msg-worker pra aplicar) ---
WORKER_CONCURRENCY=5
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5000
# Quanto tempo (ms) uma mensagem fica reagendando enquanto a instância está
# desconectada antes de desistir de vez. Não consome WORKER_RETRY_ATTEMPTS.
WORKER_INSTANCE_WAIT_TIMEOUT_MS=1200000
# Intervalo (ms) entre re-checagens de status enquanto aguarda a instância.
WORKER_INSTANCE_RECHECK_DELAY_MS=10000
# Intervalo mínimo (ms) entre chamadas de /reconnect pra mesma instância.
WORKER_INSTANCE_RECONNECT_COOLDOWN_MS=15000
# Quantas vezes a mesma mensagem pode ser reagendada por rate limit do
# provedor antes de desistir. Não consome WORKER_RETRY_ATTEMPTS.
WORKER_MAX_RATE_LIMIT_DEFERRALS=5
# Espaçamento entre envios da MESMA instância:
#   intervalo mínimo = max(60s / limite por minuto do nível, ANTIBAN_MIN_DELAY_MS)
#   intervalo real   = mínimo + sorteio de até (ANTIBAN_MAX_DELAY_MS - ANTIBAN_MIN_DELAY_MS)
ANTIBAN_MIN_DELAY_MS=2000
ANTIBAN_MAX_DELAY_MS=6000
# Até quanto (ms) um job espera a vez dentro do worker; acima disso volta pra fila
ANTIBAN_MAX_INLINE_WAIT_MS=5000
# Pausa da instância quando a Meta/WhatsApp responde rate limit: começa na
# base e dobra a cada ocorrência seguida, até o teto
ANTIBAN_COOLDOWN_BASE_MS=60000
ANTIBAN_COOLDOWN_MAX_MS=1800000
ANTIBAN_WARMUP_DAYS_TO_WARM=3
ANTIBAN_WARMUP_DAYS_TO_HOT=7
# instanceIds (separados por vírgula) que pulam o aquecimento gradual
ANTIBAN_TRUSTED_INSTANCES=
# teto de segurança: soma de envios de TODAS as instâncias no dia
ANTIBAN_GLOBAL_DAILY_LIMIT=1000

# --- Opt-out ("Não tenho interesse") ---
# Rodapé somado a toda mensagem de campanha. Vazio = texto padrão
# ("Não quer mais receber nossas mensagens? Responda: Não tenho interesse").
# "off" = sem rodapé. Se trocar a frase, ela precisa estar entre as que o
# engine reconhece (OPT_OUT_PHRASES em Ant_Engine_Bn/src/whatsapp/opt-out.ts).
OPT_OUT_FOOTER=
# Resposta enviada a quem pediu pra sair. Vazio = texto padrão, "off" = não responde.
OPT_OUT_CONFIRMATION=

# --- IA (opcional) ---
# Cada usuário cadastra a própria chave e escolhe o provedor no menu "IA" do
# painel - não precisa configurar nada aqui pra isso funcionar.
# ANTHROPIC_API_KEY: chave do servidor, usada só por quem ainda não cadastrou
# a própria. HEALTH_AI_MODEL: modelo usado com essa chave.
ANTHROPIC_API_KEY=
HEALTH_AI_MODEL=claude-opus-5-5
# Segredo que cifra as chaves de API dos usuários no banco. Vazio = usa o
# CRM_JWT_SECRET. Trocar invalida as chaves salvas (os usuários recadastram).
AI_KEYS_ENCRYPTION_KEY=

# --- CRM (usuário admin inicial + auth) ---
# Só usado pra criar a 1a conta no banco, na primeira vez que o banco sobe
# vazio. Depois disso, gerencie usuários pela tela "Usuários" do CRM.
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_EMAIL=voce@example.com
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# ATENCAO: duplique TODO "$" do hash gerado para "$$" antes de colar aqui
# (ex: $2a$10$xyz -> $$2a$$10$$xyz) - o Compose interpreta "$" como variável
# dentro do .env e corrompe o hash silenciosamente sem esse escaping.
CRM_ADMIN_PASSWORD_HASH=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_JWT_SECRET=
CRM_JWT_EXPIRES_IN=24h
