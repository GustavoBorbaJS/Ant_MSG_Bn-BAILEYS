# Único .env usado pelo docker-compose.yml da raiz (o que você cola no campo
# "Environment" do Dokploy). Reúne o que antes ficava espalhado em
# Ant_CRM_Bn/.env, Ant_Engine_Bn/.env e Ant_MSG_Bn/.env - só pra rodar via
# Docker. Pra rodar cada projeto direto (npm run start:dev, sem Docker),
# continue usando o .env.example de cada subpasta normalmente.

# --- PostgreSQL (compartilhado por crm-api e msg-worker) ---
DB_USERNAME=postgres
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_PASSWORD=change_me
DB_NAME=wa_saas

# --- Redis (compartilhado por crm-api e msg-worker) ---
# NUNCA deixe em branco em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change_me

# --- Engine (Baileys) ---
# Toda rota do engine exige "Authorization: Bearer <esse valor>" - usado
# tambem por crm-api e msg-worker pra chamar o engine, por isso é UM valor só
# compartilhado pelos 3 serviços.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENGINE_API_KEY=

# Criptografa (AES-256-GCM) as credenciais de sessão do Baileys em disco.
# NUNCA reaproveite entre ambientes - sem essa chave as sessões existentes
# ficam irrecuperáveis. Faça backup dela separado do volume de sessões.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSIONS_ENCRYPTION_KEY=

LOG_LEVEL=info

# Meta Cloud API (número oficial, opcional)
META_API_VERSION=v21.0
# Exemplo: META_INSTANCES={"oficial-1":{"phoneNumberId":"1234567890","accessToken":"EAAxxxxx"}}
META_INSTANCES=

# --- Anti-ban (usado por crm-api pra exibir e msg-worker pra aplicar) ---
WORKER_CONCURRENCY=5
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5000
ANTIBAN_MIN_DELAY_MS=2000
ANTIBAN_MAX_DELAY_MS=6000
ANTIBAN_WARMUP_DAYS_TO_WARM=3
ANTIBAN_WARMUP_DAYS_TO_HOT=7
# instanceIds (separados por vírgula) que pulam o aquecimento gradual
ANTIBAN_TRUSTED_INSTANCES=
# teto de segurança: soma de envios de TODAS as instâncias no dia
ANTIBAN_GLOBAL_DAILY_LIMIT=1000

# --- CRM (usuário admin inicial + auth) ---
# Só usado pra criar a 1a conta no banco, na primeira vez que o banco sobe
# vazio. Depois disso, gerencie usuários pela tela "Usuários" do CRM.
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_EMAIL=voce@example.com
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# ATENCAO: duplique TODO "$" do hash gerado para "$$" antes de colar aqui
# (ex: $2a$10$xyz -> $$2a$$10$$xyz) - o Compose interpreta "$" como variável
# dentro do .env e corrompe o hash silenciosamente sem esse escaping.
CRM_ADMIN_PASSWORD_HASH=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_JWT_SECRET=
CRM_JWT_EXPIRES_IN=24h
