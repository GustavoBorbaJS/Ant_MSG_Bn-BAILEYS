# HTTP server
CRM_PORT=3002

# PostgreSQL - mesmo banco do worker (Ant_MSG_Bn) - use os mesmos valores de la
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=wa_saas

# Redis - mesmo do worker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# Engine (Baileys) - precisa ser IGUAL ao ENGINE_API_KEY do Ant_Engine_Bn/.env
ENGINE_API_URL=http://localhost:3001
ENGINE_API_KEY=

# Producao de jobs na fila 'messages' - mesmos valores do Ant_MSG_Bn/.env
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5000

# Anti-ban (somente leitura, mesmos valores do Ant_MSG_Bn/.env)
ANTIBAN_WARMUP_DAYS_TO_WARM=3
ANTIBAN_WARMUP_DAYS_TO_HOT=7
ANTIBAN_TRUSTED_INSTANCES=

# Usuario admin inicial - so usado pra criar a 1a conta no banco (users), na
# primeira vez que sobe. Depois disso, gerencie usuarios pela tela "Usuarios".
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_EMAIL=voce@example.com
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
# ATENCAO ao rodar via docker-compose (raiz do repo): esse valor eh lido via
# "env_file", e o Compose interpreta "$" como inicio de variavel dentro de
# env_file tambem - um hash bcrypt (formato $2a$10$...) sem escapar quebra
# silenciosamente (vira vazio a partir do primeiro $letra). Duplique TODO "$"
# do hash gerado para "$$" antes de colar aqui (ex: $2a$10$xyz -> $$2a$$10$$xyz).
CRM_ADMIN_PASSWORD_HASH=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_JWT_SECRET=
CRM_JWT_EXPIRES_IN=24h
