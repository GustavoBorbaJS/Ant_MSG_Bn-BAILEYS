# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# NUNCA deixe em branco em produção. Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change_me

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# NUNCA use um placeholder em produção. Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DB_PASSWORD=change_me
DB_NAME=wa_saas

# Engine API Configuration
ENGINE_API_URL=http://localhost:3001
# precisa ser IGUAL ao ENGINE_API_KEY do Ant_Engine_Bn/.env. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENGINE_API_KEY=

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5000

# Log Level
LOG_LEVEL=debug

# Anti-ban Configuration (opcional, ja tem defaults sensatos)
ANTIBAN_MIN_DELAY_MS=2000
ANTIBAN_MAX_DELAY_MS=6000
ANTIBAN_WARMUP_DAYS_TO_WARM=3
ANTIBAN_WARMUP_DAYS_TO_HOT=7
# instanceIds (separados por virgula) de numeros ja estabelecidos, que pulam o
# aquecimento gradual e vao direto para o nivel 'hot'. Ex: inst-1,inst-2
ANTIBAN_TRUSTED_INSTANCES=
# teto de seguranca: soma de envios de TODAS as instancias no dia
ANTIBAN_GLOBAL_DAILY_LIMIT=1000
