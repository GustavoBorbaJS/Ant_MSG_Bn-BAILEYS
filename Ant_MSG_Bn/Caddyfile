{
	# email usado pelo Let's Encrypt pra avisos de expiracao/problemas de certificado
	email {$CADDY_ACME_EMAIL:admin@example.com}
}

# ENGINE_DOMAIN=localhost (default) -> Caddy usa certificado local auto-assinado,
# valido so pra teste na propria maquina (curl precisa de -k).
# ENGINE_DOMAIN=engine.suastartup.com -> Caddy emite e renova HTTPS de verdade via
# Let's Encrypt automaticamente, contanto que o DNS aponte pro servidor e as portas
# 80/443 estejam abertas pra internet.
{$ENGINE_DOMAIN:localhost} {
	reverse_proxy engine:3001
}
