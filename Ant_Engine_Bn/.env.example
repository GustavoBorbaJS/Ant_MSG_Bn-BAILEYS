# HTTP server
ENGINE_PORT=3001

# Segredo compartilhado com o worker (ENGINE_API_KEY no .env do Ant_MSG_Bn precisa ser IGUAL).
# Toda rota do engine exige "Authorization: Bearer <esse valor>". Gere um novo por ambiente com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENGINE_API_KEY=

# Chave usada pra criptografar (AES-256-GCM) as credenciais de sessao do Baileys em disco.
# NUNCA reaproveite entre ambientes, e faça backup dela separado do volume de sessoes:
# sem essa chave as sessoes existentes ficam irrecuperaveis. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSIONS_ENCRYPTION_KEY=

# Onde as credenciais de sessao do Baileys (por instancia) sao persistidas
SESSIONS_DIR=./sessions

# Log Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Meta Cloud API (numero oficial, opcional)
# instanceIds listados aqui sao roteados pra Meta em vez do Baileys.
# Pegue phoneNumberId e accessToken no Meta Business Manager > WhatsApp > API Setup.
META_API_VERSION=v21.0
# Exemplo: META_INSTANCES={"oficial-1":{"phoneNumberId":"1234567890","accessToken":"EAAxxxxx"}}
META_INSTANCES=
